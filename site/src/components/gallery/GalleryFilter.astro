---
/**
 * The gallery's filter: "All", then each kind that has entries, as text
 * buttons on an ink rule (tiles.css), each named with its count ("Maps 3
 * graphics"), and the polite live region a change is read out in. With scripts
 * expected the row is laid out but invisible until src/scripts/gallery.ts wires
 * it, so it holds exactly its own height at every width and nothing moves when
 * it appears; without JavaScript it is not shown at all, and the wall shows
 * every tile. Each button carries the sentence its choice announces.
 *
 * Each kind's button has the id `kind=<kind>`, so an entry page's breadcrumb link
 * to /examples/#kind=<kind> names an element that exists (the build's link check
 * reads it that way) and, without JavaScript, lands on the filter row.
 *
 * Contract (src/scripts/gallery.ts relies on it): `fieldset[data-gallery-filter]`,
 * given `data-ready` once wired, holding `button[data-filter=<all|kind>][data-announce][aria-pressed]`,
 * and `[data-gallery-status]`, the live region.
 */
import type { VisualizationSectionId } from "../../config";
import type { GalleryEntry } from "../../lib/gallery-types";
import { kindCounts, type TileFilter } from "../shared/tiles/tile-filter";
import { filterAnnouncement, KINDS, kindLabel } from "./kind-words";

type Props = { entries: readonly GalleryEntry[] };

const { entries } = Astro.props;
const counts = kindCounts(entries.map((entry) => entry.kind));
const options: { id: TileFilter<VisualizationSectionId>; label: string; count: number }[] = [
  { id: "all", label: "All", count: entries.length },
  ...KINDS.filter((kind) => counts.has(kind)).map((kind) => ({
    id: kind,
    label: kindLabel(kind),
    count: counts.get(kind) ?? 0,
  })),
];
---

<fieldset class="tile-filter gallery-filter" data-gallery-filter>
  <legend class="sr-only">Show one kind of graphic</legend>
  {options.map((option) => (
    <button
      type="button"
      class="tile-filter-button"
      id={option.id === "all" ? undefined : `kind=${option.id}`}
      data-filter={option.id}
      data-announce={filterAnnouncement(option.id, option.count)}
      aria-pressed={option.id === "all" ? "true" : "false"}
    >
      {option.label}
      <span class="tile-count">{option.count}</span>
      <span class="sr-only">{option.count === 1 ? " graphic" : " graphics"}</span>
    </button>
  ))}
</fieldset>
<p class="sr-only" aria-live="polite" data-gallery-status></p>
