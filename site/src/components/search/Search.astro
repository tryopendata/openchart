---
/**
 * The header's search control: the trigger button and the dialog it opens.
 * src/scripts/search.ts (eager) wires the trigger and the shortcuts and shows
 * the trigger; src/scripts/search-dialog.ts (loaded on first hover, focus or
 * open) runs the combobox and fills the listbox. The dialog never opens without
 * JavaScript, and its contents sit outside every indexed element.
 *
 * Contract (src/scripts/search.ts and tests/build.test.ts rely on it):
 * - `button[data-search-trigger]` with `aria-haspopup="dialog"` and
 *   `aria-controls="site-search"`, named "Search". Its box is fixed at every
 *   width, and global.css keeps it `visibility: hidden` (space reserved, not
 *   focusable) until the script sets `data-search-ready`.
 * - `[data-search-hint]` inside it: a fixed-width slot for the shortcut hint,
 *   shown from 640px.
 * - `dialog#site-search[data-search]`, labelled "Search the site", holding the
 *   combobox input, the listbox, the "Searching…" line (shown, never announced)
 *   and the status line (visually hidden unless it holds a message such as "No
 *   results"). The status line carries SEARCH_UNAVAILABLE in
 *   `data-load-error`, for search.ts to show when the dialog code fails to load.
 */
import { SEARCH_UNAVAILABLE } from "../../lib/search-index";
import "../../styles/search.css";
---

<button
  type="button"
  data-search-trigger
  aria-haspopup="dialog"
  aria-controls="site-search"
  class="border-line text-ink-2 hover:border-line-strong hover:text-ink flex h-8 w-8 shrink-0 items-center justify-center gap-2 rounded-xs border text-[13px] transition-colors duration-150 sm:w-36 sm:justify-start sm:px-2.5"
>
  <svg viewBox="0 0 16 16" aria-hidden="true" class="size-4 shrink-0">
    <circle cx="7" cy="7" r="4.75" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
    <path d="m10.5 10.5 3.75 3.75" stroke="currentColor" stroke-width="1.5" fill="none"></path>
  </svg>
  <span class="max-sm:sr-only">Search</span>
  <span
    data-search-hint
    aria-hidden="true"
    class="text-muted ml-auto hidden w-12 text-right font-mono text-xs sm:block"
  ></span>
</button>
<dialog id="site-search" data-search aria-label="Search the site" class="search-dialog">
  <div class="search-bar">
    <span class="search-field">
      <svg viewBox="0 0 16 16" aria-hidden="true" class="search-field-icon">
        <circle
          cx="7"
          cy="7"
          r="4.75"
          fill="none"
          stroke="currentColor"
          stroke-width="1.5"
        ></circle>
        <path d="m10.5 10.5 3.75 3.75" stroke="currentColor" stroke-width="1.5" fill="none"></path>
      </svg>
      <input
        type="text"
        data-search-input
        role="combobox"
        aria-label="Search the site"
        aria-expanded="false"
        aria-controls="site-search-results"
        aria-autocomplete="list"
        autocomplete="off"
        autocapitalize="off"
        spellcheck="false"
        enterkeyhint="go"
        placeholder="Search the site"
        class="search-input"
      />
    </span>
    <button type="button" data-search-close class="search-close">
      Close
    </button>
  </div>
  <div class="search-body">
    <div
      id="site-search-results"
      role="listbox"
      aria-label="Search results"
      data-search-results
      hidden
    ></div>
    <p data-search-progress class="search-message" hidden></p>
    <p
      role="status"
      data-search-status
      data-load-error={SEARCH_UNAVAILABLE}
      class="search-message sr-only"
    ></p>
  </div>
</dialog>
