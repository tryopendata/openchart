---
/**
 * The install commands as a ruled list, one package manager per line, each with
 * a Copy button that @steamfield/ui's `enhanceCopyButtons` wires (Closing.astro's
 * script) and that stays hidden without JavaScript. Takes the same props as the
 * shared InstallCommand.astro, which is meant to replace it.
 */
import { CopyCommand } from "@steamfield/ui/react/copy";

type Props = { commands: { label: string; command: string }[] };

const { commands } = Astro.props;
---

<ul class="closing-commands" aria-label="Install commands">
  {commands.map(({ label, command }) => (
    <li class="closing-command" data-motion-part>
      <span class="closing-manager">{label}</span>
      <CopyCommand
        id={`closing-install-${label}`}
        command={command}
        prompt={null}
        label={`Copy the ${label} install command`}
        className="closing-command-text"
        buttonClassName="copy-chip"
      />
    </li>
  ))}
</ul>
