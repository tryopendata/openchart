---
/**
 * Frameworks: a code bench with React, Vue, Svelte and Vanilla tabs (the
 * InstallTabs island, client:visible), each holding the install command and the
 * usage sample the docs generate for one small spec, beside the chart that spec
 * draws. The tabs share the docs demo tabs' stored choice (`openchart:framework`).
 *
 * Contract (e2e/landing.spec.ts and tests/build.test.ts rely on it):
 * - `<section id="frameworks" aria-labelledby="frameworks-title" data-landing-section>`
 *   with one h2, id `frameworks-title` (`landingCopy.headings.frameworks`).
 * - Tabs (`role="tab"`) named "React", "Vue", "Svelte" and "Vanilla", each
 *   controlling a `role="tabpanel"`.
 * - Each panel's install command reads `npm install @opendata-ai/openchart-<framework>`
 *   (react, vue, svelte, vanilla), and every panel is in the server-rendered HTML.
 */
import { FRAMEWORK_STORAGE_KEY } from "../../../lib/demo/framework-choice";
import { highlightCode } from "../../../lib/demo/highlight";
import { staticSvgPair } from "../../../lib/demo/static-svg";
import PublishedFigure from "../../shared/PublishedFigure.astro";
import SectionHead from "../../shared/SectionHead.astro";
import { benchSource, benchSpec } from "./bench-spec";
import { frameworkPanels } from "./framework-panels";
import { LANDING_FRAMEWORKS } from "./framework-tabs";
import { INSTALL_TABS_ID, type InstallPanel, InstallTabs } from "./InstallTabs";
import "../../../styles/landing-close.css";

const panels = frameworkPanels(benchSpec);
const highlighted = await highlightCode(panels.map(({ shown, lang }) => ({ code: shown, lang })));
const installPanels: InstallPanel[] = panels.map(
  ({ shown: _shown, lang: _lang, ...panel }, index) => ({
    ...panel,
    html: highlighted.html[index] ?? "",
  }),
);

/** The SVG's drawing size; CSS scales it to the figure's width. */
const CHART_SIZE = { width: 480, height: 400 };
const chartSvgs = staticSvgPair(benchSpec, { idPrefix: "bench-chart", ...CHART_SIZE });
---

<section
  id="frameworks"
  aria-labelledby="frameworks-title"
  data-landing-section
  class="landing-section"
>
  <div class="landing-container">
    <SectionHead id="frameworks" layout="feature">
      Install the package for your framework and hand it the spec. The code below draws the chart
      beside it, and the docs show the same four versions under every example.
    </SectionHead>
    <div class="frameworks-bench">
      <div class="frameworks-code">
        <InstallTabs client:visible panels={installPanels} />
        {/* Shows the stored tab before paint; InstallTabs reads the same choice when it hydrates. */}
        <script
          is:inline
          define:vars={{
            key: FRAMEWORK_STORAGE_KEY,
            ids: LANDING_FRAMEWORKS,
            base: INSTALL_TABS_ID,
          }}
        >
          try {
            const choice = localStorage.getItem(key);
            if (ids.includes(choice)) {
              for (const id of ids) {
                const panel = document.getElementById(`${base}-${id}`);
                if (id === choice) panel?.setAttribute("data-default", "");
                else panel?.removeAttribute("data-default");
              }
            }
          } catch {
            // Storage blocked: the default tab shows, as it would after hydration.
          }
        </script>
      </div>
      <PublishedFigure class="frameworks-figure" source={benchSource} note="What each tab renders.">
        <div class="frameworks-chart" set:html={chartSvgs} />
      </PublishedFigure>
    </div>
  </div>
  <style is:inline set:html={highlighted.css}></style>
</section>
