---
/**
 * The hero, "the desk": the page's h1 and lede, the two links and the install
 * command, and an interactive newsroom figure rendering one US electricity
 * generation dataset (2016–2023) across four editorial forms. The graphic is
 * the hero; the JSON spec that builds the active view waits in a disclosure
 * underneath. The text block takes 4 of the 12 columns and the figure 8 from
 * 1100px; below that the figure follows the text. The figure uses published-
 * graphic framing: a ticked rule, the section's h2 as its headline, the
 * HeroDesk island, and a caption with the source line.
 *
 * Contract (e2e/landing.spec.ts and tests/build.test.ts rely on it):
 * - `<section id="desk" aria-labelledby="desk-title" data-landing-section>` holding
 *   the page's only h1 (`landingCopy.headline`) and one h2 with id `desk-title`
 *   (`landingCopy.headings.desk`).
 * - The desk opens immediately on the hands-on default (`Line` + `Coal`), with
 *   zero autoplay or transport timers. Before mount (and without JavaScript),
 *   the four editorial forms and the fuel focus strip render as plain lists.
 * - Once mounted, the four editorial forms (`Line`, `Small multiples`,
 *   `Stacked area`, `Data table`) render as a WAI-ARIA `tablist` named
 *   "Editorial forms" controlling the stage `tabpanel`, and the fuel focus
 *   strip renders as a `group` named "Spotlight a fuel" whose buttons toggle
 *   `aria-pressed` (`All`, `Coal`, `Gas`, `Nuclear`, `Wind`, `Solar`, `Hydro`).
 * - Clicking a fuel row in `Data table` toggles that fuel's spotlight (and
 *   clicking the active fuel resets to `All`).
 * - The spec pane sits in a `<details>` (`SpecDisclosure`) under the stage,
 *   closed by default; its text is in the HTML either way. Under 700px, when
 *   hydrated and the active view has added lines, the pane collapses to added
 *   lines with a button named "Show full spec".
 * - `data-hero-spec` on the spec pane; each line differing from the view's
 *   baseline carries `data-spec-added`. `data-hero-chart` and `data-hero-kind`
 *   on the stage holding the chart's SVG (already present in the server render)
 *   or live DataTable.
 * - The figure has a `<figcaption>` with a "Source: …" line.
 *
 * Nothing above the fold waits on a script to show: the text block's entrance
 * is a CSS rise that moves it (never hides it), and the figure opts out of
 * `data-reveal`. The chart's own entrance is the library's, when it goes live.
 */
import { site } from "../../../config";
import { landingCopy } from "../../../landing/copy";
import {
  buildHeroSpec,
  DEFAULT_HERO_FORM,
  DEFAULT_HERO_SPOTLIGHT,
  heroSource,
} from "../../../landing/hero";
import { staticSvgPair } from "../../../lib/demo/static-svg";
import "../../../styles/landing-hero.css";
import HeroDesk from "./HeroDesk";
import InstallCommand from "../../shared/InstallCommand.astro";
import PublishedFigure from "../../shared/PublishedFigure.astro";

/** The static SVG's drawing size: the live chart's at 1440, so the swap does not move. */
const STATIC_SIZE = { width: 904, height: 480 };

const staticCharts = staticSvgPair(buildHeroSpec(DEFAULT_HERO_FORM, DEFAULT_HERO_SPOTLIGHT), {
  ...STATIC_SIZE,
  idPrefix: "hero",
});
---

<section id="desk" aria-labelledby="desk-title" data-landing-section class="landing-section hero">
  <div class="landing-container hero-grid">
    <div class="hero-text">
      <h1 class="landing-display hero-title hero-rise">{landingCopy.headline}</h1>
      <p class="landing-lede hero-lede hero-rise" style="--rise-delay: 80ms">
        {landingCopy.lede}
      </p>
      <p class="hero-links hero-rise" style="--rise-delay: 160ms">
        <a href="/docs/get-started/getting-started/" class="hero-action">
          Read the docs
        </a>
        <a href="#vocabulary" class="hero-link">
          See every chart type <span aria-hidden="true">→</span>
        </a>
      </p>
      <div class="hero-install hero-rise" style="--rise-delay: 220ms">
        <InstallCommand id="hero-install" commands={site.install} />
      </div>
    </div>

    <PublishedFigure
      class="hero-figure"
      title={landingCopy.headings.desk}
      titleId="desk-title"
      level="h2"
      source={heroSource}
      reveal={false}
      note="One dataset of US electricity generation (2016–2023) rendered across four editorial forms. Switch views or spotlight any fuel, and open the spec below to inspect the JSON."
    >
      <HeroDesk client:load>
        <Fragment set:html={staticCharts} />
      </HeroDesk>
    </PublishedFigure>
  </div>
</section>
