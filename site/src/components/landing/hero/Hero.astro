---
/**
 * The hero, "the desk": the page's h1 and lede, the install command with copy,
 * and a figure where a spec is written in steps and the chart beside it updates.
 * The text block takes 5 of the 12 columns and the figure 7 from 1100px; below
 * that the figure follows the text. The figure is published-graphic framing: a
 * ticked rule, the section's h2 as its headline, the HeroDesk island, and a
 * caption with the source line.
 *
 * Contract (e2e/landing.spec.ts and tests/build.test.ts rely on it):
 * - `<section id="desk" aria-labelledby="desk-title" data-landing-section>` holding
 *   the page's only h1 (`landingCopy.headline`) and one h2 with id `desk-title`
 *   (`landingCopy.headings.desk`).
 * - The step list is a list named "Spec steps" whose five items are buttons; the
 *   current one carries `aria-current="step"`. Controls are buttons named
 *   "Pause" (or "Play" while paused), "Previous step" and "Next step". Under 700px
 *   the collapsed spec pane opens with a button named "Show full spec".
 * - `data-hero-spec` on the spec pane; each line the current step added carries
 *   `data-spec-added`. `data-hero-chart` on the element holding the chart's SVG,
 *   which the server render already contains.
 * - The figure has a `<figcaption>` with a "Source: …" line.
 * - Before hydration and under reduced motion the last step is current.
 *
 * Entrances use `data-reveal` from @steamfield/ui (wired by the layout), which
 * leaves everything visible without JavaScript and under reduced motion.
 */
import { site } from "../../../config";
import { landingCopy } from "../../../landing/copy";
import { heroSource, heroSteps } from "../../../landing/hero";
import { staticSvg } from "../../../lib/demo/static-svg";
import "../../../styles/landing-hero.css";
import { toDeskSteps } from "./desk-step";
import HeroDesk from "./HeroDesk";
import InstallCommand from "../../shared/InstallCommand.astro";
import PublishedFigure from "../../shared/PublishedFigure.astro";

/** The static SVG's drawing size: close to the live chart's at 1440, so the swap barely moves. */
const STATIC_SIZE = { width: 520, height: 460 };

const deskSteps = toDeskSteps(heroSteps);
const finished = heroSteps.at(-1)?.spec;
if (!finished) throw new Error("src/landing/hero.ts exports no steps: the hero needs five.");
// Rendering writes defaults into the spec, so each render gets its own copy.
const staticCharts = [false, true]
  .map((dark) =>
    staticSvg(structuredClone(finished), {
      ...STATIC_SIZE,
      idPrefix: dark ? "hero-d" : "hero-l",
      dark,
    }),
  )
  .join("");
---

<section id="desk" aria-labelledby="desk-title" data-landing-section class="landing-section hero">
  <div class="landing-container hero-grid">
    <div class="hero-text" data-reveal>
      <h1 class="landing-display hero-title" data-motion="blur-in-soft">
        {landingCopy.headline}
      </h1>
      <p class="landing-lede hero-lede" data-motion="lift-md">
        {landingCopy.lede}
      </p>
      <div class="hero-install" data-motion="lift-sm">
        <InstallCommand commands={site.install} />
      </div>
      <p class="hero-links" data-motion="lift-sm">
        <a href="/docs/get-started/getting-started/" class="hero-link hero-link-primary">
          Read the docs <span aria-hidden="true">→</span>
        </a>
        <a href={site.repo} class="hero-link">
          Source on GitHub
        </a>
      </p>
    </div>

    <PublishedFigure
      class="hero-figure"
      title={landingCopy.headings.desk}
      titleId="desk-title"
      level="h2"
      source={heroSource}
      note="Five steps write the spec. Each adds the marked lines, and the chart redraws with the library's own transition."
    >
      <HeroDesk client:load steps={deskSteps}>
        <Fragment set:html={staticCharts} />
      </HeroDesk>
    </PublishedFigure>
  </div>
</section>
