---
/**
 * Motion: one chart of 2024 US payrolls with a bench of controls, "Replay
 * entrance", "Next month" (a data update) and a fluid, subtle or off choice
 * mapped to the spec's `animation` field, with the spec lines they change. The
 * MotionReplay island hydrates when visible; before that the opening chart shows
 * as static SVG.
 *
 * Contract: `<section id="motion" aria-labelledby="motion-title" data-landing-section>`
 * with one h2, id `motion-title` (`landingCopy.headings.motion`). The chart's
 * figure has a `<figcaption>` with a "Source: …" line.
 */
import { landingCopy } from "../../../landing/copy";
import { staticSvg } from "../../../lib/demo/static-svg";
import PublishedFigure from "../../shared/PublishedFigure.astro";
import { MotionReplay } from "./MotionReplay";
import { FIRST_MONTHS, motionSource, payrollSpec } from "./motion-spec";
import "../../../styles/landing-story.css";

const opening = payrollSpec(FIRST_MONTHS, "fluid");
const statics = [false, true]
  .map((dark) =>
    staticSvg(opening, { width: 720, height: 420, dark, idPrefix: `motion-${dark ? "d" : "l"}` }),
  )
  .join("");
---

<section id="motion" aria-labelledby="motion-title" data-landing-section class="landing-section">
  <div class="landing-container">
    <div class="rule-axis landing-rule" aria-hidden="true"></div>
    <div class="motion-head" data-reveal>
      <h2 id="motion-title" class="landing-heading" data-motion="lift-md">
        {landingCopy.headings.motion}
      </h2>
    </div>
    <PublishedFigure source={motionSource}>
      <MotionReplay client:visible>
        <Fragment set:html={statics} />
      </MotionReplay>
    </PublishedFigure>
  </div>
</section>
