---
/**
 * Motion opens on a bubble playback of wealth and health from 1960 to 2022.
 * PlaybackFigure shows the last period as static SVG, at three widths, until it
 * loads the demo on sight. Below it, MotionReplay lets readers replay the payroll chart's
 * entrance, add a month and change the animation style. Both islands hydrate
 * when visible.
 *
 * Contract: `<section id="motion" aria-labelledby="motion-title" data-landing-section>`
 * with one h2, id `motion-title` (`landingCopy.headings.motion`). The first
 * figure holds `[data-playback-figure]` and the second holds the payroll bench.
 * Each figure has a `<figcaption>` with a "Source: …" line.
 */
import { wealthHealthSource } from "../../../demos/correlation/wealth-health-history";
import { landingPlayback, landingPlaybackSpec } from "../../../demos/landing/playback";
import { staticSvgPair, staticSvgSet } from "../../../lib/demo/static-svg";
import PublishedFigure from "../../shared/PublishedFigure.astro";
import SectionHead from "../../shared/SectionHead.astro";
import { MotionReplay } from "./MotionReplay";
import { PlaybackFigure } from "./PlaybackFigure";
import { FIRST_MONTHS, motionSource, payrollSpec } from "./motion-spec";
import "../../../styles/landing-motion.css";

// The library's playback controls take a strip under the plot
// (PLAYBACK_CONTROLS_HEIGHT in packages/vanilla/src/playback/controls.ts).
const CONTROLS_STRIP = 44;
const stage = { wide: landingPlayback.height ?? 520, phone: landingPlayback.phoneHeight ?? 560 };
// The static render draws a playback at its last period, on the scales of the
// whole run, with its labels, trails and year. Each still is laid out at the
// narrowest container of its range, so its type never renders smaller than the
// live chart's.
const stills = staticSvgSet(landingPlaybackSpec, [
  {
    ranges: ["phone"],
    width: 350,
    height: stage.phone - CONTROLS_STRIP,
    idPrefix: "playback-phone",
    precision: 0,
  },
  {
    ranges: ["tablet"],
    width: 592,
    height: stage.wide - CONTROLS_STRIP,
    idPrefix: "playback-medium",
    precision: 0,
  },
  {
    ranges: ["lg", "xl"],
    width: 960,
    height: stage.wide - CONTROLS_STRIP,
    idPrefix: "playback-wide",
    precision: 0,
  },
]);
const seconds = (landingPlaybackSpec.playback?.duration ?? 0) / 1000;
const opening = payrollSpec(FIRST_MONTHS, "fluid");
const statics = staticSvgPair(opening, { width: 720, height: 420, idPrefix: "motion" });
---

<section id="motion" aria-labelledby="motion-title" data-landing-section class="landing-section">
  <div class="landing-container">
    <SectionHead id="motion">
      The first chart plays GDP per person against life expectancy from 1960 to 2022 in {seconds}
      seconds. Pause it or drag to any year. In the second, Next month adds a bar and the other bars
      animate to their new widths.
    </SectionHead>
    <PublishedFigure class="figure-hairline" source={wealthHealthSource}>
      <div
        class="motion-playback"
        style={`--playback-height: ${stage.wide}px; --playback-phone-height: ${stage.phone}px; --playback-controls: ${CONTROLS_STRIP}px`}
      >
        <PlaybackFigure client:visible>
          <div class="motion-playback-still">
            <Fragment set:html={stills} />
          </div>
        </PlaybackFigure>
      </div>
    </PublishedFigure>
    <PublishedFigure
      class="figure-hairline"
      source={motionSource}
      title="Add a month to see the update animation"
    >
      <MotionReplay client:visible>
        <Fragment set:html={statics} />
      </MotionReplay>
    </PublishedFigure>
  </div>
</section>
