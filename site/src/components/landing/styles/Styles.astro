---
/**
 * One chart shown in each built-in theme: a pinned, scrubbed section where one
 * chart moves through the essay, wire, broadsheet and terminal presets and then
 * dark mode. The stops, their descriptions and diffs, and the first stop's static
 * chart are computed here at build time; the PresetScrub island (client:visible)
 * runs the chart, the pin and the buttons.
 *
 * Contract (e2e/landing.spec.ts relies on it):
 * - `<section id="styles" aria-labelledby="styles-title" data-landing-section>`
 *   with one h2, id `styles-title` (`landingCopy.headings.styles`).
 * - `data-preset-name` on the visible element naming the current preset; its text
 *   is the preset name ("essay", "wire", "broadsheet", "terminal"), case aside.
 * - Where the pin applies it happens inside this section: ScrollTrigger pins an
 *   element within it, so the section itself stays a direct child of `<main>`.
 * - Without the pin (narrow or short screens, reduced motion) the presets are
 *   buttons named by preset ("Essay", "Wire", "Broadsheet", "Terminal").
 */
import type { ChartSpec } from "@opendata-ai/openchart-core";
import { renderStaticSVG } from "@opendata-ai/openchart-vanilla/static";
import { houseStyle } from "../../../demos/landing/house-style";
import { DEFAULT_DEMO_HEIGHT } from "../../../demos/types";
import { validateDemo } from "../../../lib/demo/validate";
import "../../../styles/landing-styles.css";
import "../../../styles/preset-fonts.css";
import PublishedFigure from "../../shared/PublishedFigure.astro";
import SectionHead from "../../shared/SectionHead.astro";
import { HOUSE_STYLE_STOPS, houseStyleDiffs } from "./house-styles";
import { PresetScrub } from "./PresetScrub";

/**
 * The static stand-in's layout width: narrow enough that its type stays readable
 * when a phone scales it down, before the live chart lays itself out at the real width.
 */
const STAND_IN_WIDTH = 560;

validateDemo(houseStyle.id, houseStyle.spec);
const spec = houseStyle.spec as ChartSpec;
const diffs = houseStyleDiffs();
const stops = HOUSE_STYLE_STOPS.map((stop, index) => ({ ...stop, diff: diffs[index] ?? [] }));
const first = HOUSE_STYLE_STOPS[0];

// The preset is the spec's own theme and no site theme is passed: a mount theme
// would override the preset's fonts and paper, which are the point of the section.
const initialSvg = renderStaticSVG(
  { ...spec, theme: first?.theme, watermark: false },
  {
    idPrefix: "house-style",
    width: STAND_IN_WIDTH,
    height: houseStyle.height ?? DEFAULT_DEMO_HEIGHT,
    darkMode: "off",
    precision: 1,
  },
);
---

<section id="styles" aria-labelledby="styles-title" data-landing-section class="landing-section">
  <div class="landing-container">
    <SectionHead id="styles" layout="beside">
      This chart runs through the four built-in themes and dark mode. For your own house style,
      write a theme with your fonts and colors, or change a few values in a built-in one, and apply
      it to one chart or to every chart on the page.
    </SectionHead>
    <PublishedFigure
      class="scrub-figure"
      source={houseStyle.source}
      note="The text above the plot is part of the chart, so each theme sets it in its own type."
    >
      <PresetScrub client:visible stops={stops} spec={spec}>
        <div class="scrub-static" set:html={initialSvg} />
      </PresetScrub>
    </PublishedFigure>
  </div>
</section>
