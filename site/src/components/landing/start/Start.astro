---
/**
 * Start: the page's last section, where a reader installs the library. A code
 * bench with React, Vue, Svelte and Vanilla tabs (the InstallTabs island,
 * client:visible), each holding the install command and the usage sample the
 * docs generate for one small spec, beside the chart that spec draws. Below it,
 * a ruled facts table (bundle and license, each linked to the file that backs
 * it), then links to the docs and GitHub. The framework tabs share the docs demo
 * tabs' stored choice (`openchart:framework`). There is no package-manager
 * install command here: each framework tab already has its own copyable command,
 * and a second, React-only one would contradict a Vue or Svelte reader's tab.
 *
 * Contract (e2e/landing.spec.ts and tests/build.test.ts rely on it):
 * - `<section id="start" aria-labelledby="start-title" data-landing-section>`
 *   with one h2, id `start-title` (`landingCopy.headings.start`).
 * - The bench (`[data-framework-bench]`) holds the framework tabs and the
 *   figure with the bench chart (two SVGs, one per theme).
 * - Framework tabs (`role="tab"` in the "Framework" tablist) named "React",
 *   "Vue", "Svelte" and "Vanilla", each controlling a `role="tabpanel"`. Each
 *   panel's install command reads `npm install @opendata-ai/openchart-<framework>`,
 *   and every panel is in the server-rendered HTML.
 * - No `[data-install-command]`: the hero holds the page's only one.
 */
import { DOCS_HOME, site } from "../../../config";
import { FRAMEWORK_STORAGE_KEY } from "../../../lib/demo/framework-choice";
import { highlightCode } from "../../../lib/demo/highlight";
import { staticSvgPair } from "../../../lib/demo/static-svg";
import PublishedFigure from "../../shared/PublishedFigure.astro";
import SectionHead from "../../shared/SectionHead.astro";
import { benchSource, benchSpec } from "./bench-spec";
import { startFacts } from "./facts";
import { frameworkPanels } from "./framework-panels";
import { LANDING_FRAMEWORKS } from "./framework-tabs";
import { INSTALL_TABS_ID, type InstallPanel, InstallTabs } from "./InstallTabs";
import "../../../styles/landing-start.css";

const panels = frameworkPanels(benchSpec);
const highlighted = await highlightCode(panels.map(({ shown, lang }) => ({ code: shown, lang })));
const installPanels: InstallPanel[] = panels.map(
  ({ shown: _shown, lang: _lang, ...panel }, index) => ({
    ...panel,
    html: highlighted.html[index] ?? "",
  }),
);

/** The SVG's drawing size; CSS scales it to the figure's width. */
const CHART_SIZE = { width: 480, height: 400 };
const chartSvgs = staticSvgPair(benchSpec, { idPrefix: "bench-chart", ...CHART_SIZE });
---

<section id="start" aria-labelledby="start-title" data-landing-section class="landing-section">
  <div class="landing-container">
    <SectionHead id="start" layout="feature">
      Install the package for your framework and hand it the spec. The code below draws the chart
      beside it, and the docs show the same four versions under every example.
    </SectionHead>
    <div class="start-bench" data-framework-bench>
      <div class="start-code">
        <InstallTabs client:visible panels={installPanels} />
        {/* Shows the stored tab before paint; InstallTabs reads the same choice when it hydrates. */}
        <script
          is:inline
          define:vars={{
            key: FRAMEWORK_STORAGE_KEY,
            ids: LANDING_FRAMEWORKS,
            base: INSTALL_TABS_ID,
          }}
        >
          try {
            const choice = localStorage.getItem(key);
            if (ids.includes(choice)) {
              for (const id of ids) {
                const panel = document.getElementById(`${base}-${id}`);
                if (id === choice) panel?.setAttribute("data-default", "");
                else panel?.removeAttribute("data-default");
              }
            }
          } catch {
            // Storage blocked: the default tab shows, as it would after hydration.
          }
        </script>
      </div>
      <PublishedFigure class="start-figure" source={benchSource} note="What each tab renders.">
        <div class="start-chart" set:html={chartSvgs} />
      </PublishedFigure>
    </div>
    <div class="start-close">
      <div class="start-table-wrap" data-reveal>
        <table class="start-table">
          <caption class="sr-only">
            OpenChart's bundle and license, each linked to the file that backs it
          </caption>
          <thead>
            <tr>
              <th scope="col">Topic</th>
              <th scope="col">What you get</th>
              <th scope="col">Backed by</th>
            </tr>
          </thead>
          <tbody>
            {startFacts.map(({ topic, fact, sources }) => (
              <tr data-motion-part>
                <th scope="row">{topic}</th>
                <td>{fact}</td>
                <td class="start-backed">
                  {sources.map(({ label, href }) => (
                    <a href={href}>{label}</a>
                  ))}
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <div class="start-next" data-reveal>
        <p class="start-links" data-motion-part>
          <a class="btn btn-primary" href={DOCS_HOME}>
            Read the docs
          </a>
          <a class="btn" href={site.repo}>
            GitHub
          </a>
        </p>
      </div>
    </div>
  </div>
  <style is:inline set:html={highlighted.css}></style>
</section>
