---
/**
 * How a landing section opens: the ticked rule, the section's h2 from
 * `landingCopy.headings`, and an optional lede (the default slot) beside it
 * from 1024px. The h2's id is `${id}-title`, the id the section's
 * `aria-labelledby` names. The hero opens on its figure's headline and the
 * closing section sets its heading inside its own grid, so neither uses this.
 * Space after the head belongs to whatever follows it.
 *
 * `layout` keeps the three settled designs (styles in landing.css):
 * - "aside" (default): the lede in the last four columns.
 * - "beside": the lede in the five columns after the heading, both on one baseline.
 * - "feature": a larger lede in the five columns after the heading, entering
 *   with it rather than one stagger step behind.
 */
import { type LandingSectionId, landingCopy } from "../../landing/copy";

type Props = {
  /** The section's id: picks the heading and names it `${id}-title`. */
  id: LandingSectionId;
  layout?: "aside" | "beside" | "feature";
  class?: string;
};

const { id, layout = "aside", class: className } = Astro.props;
const ledeMotion = layout === "feature" ? { "data-motion": "lift-sm" } : { "data-motion-part": "" };
---

<div class="rule-axis landing-rule" aria-hidden="true"></div>
<div class:list={["section-head", className]} data-layout={layout} data-reveal>
  <h2 id={`${id}-title`} class="landing-heading" data-motion="lift-md">
    {landingCopy.headings[id]}
  </h2>
  {Astro.slots.has("default") && (
    <p class="section-head-lede" {...ledeMotion}>
      <slot />
    </p>
  )}
</div>
