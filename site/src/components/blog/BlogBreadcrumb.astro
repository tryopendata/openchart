---
/**
 * The way back to the blog index from a post or a tag page: one link, "Blog".
 * Search leaves it out of a post's index entry, since every post repeats it.
 */
---

<nav aria-label="Breadcrumb" data-pagefind-ignore>
  <a
    href="/blog/"
    class="text-muted hover:text-ink text-[13px] no-underline transition-colors duration-150"
  >
    Blog
  </a>
</nav>
