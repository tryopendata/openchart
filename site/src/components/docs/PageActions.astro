---
/**
 * The page's Markdown export, to copy or open. "Copy page" stays hidden until
 * site.ts wires it, so there is no dead button without JavaScript.
 */
interface Props {
  /** The page's .md export URL. */
  markdown: string;
}
const { markdown } = Astro.props;
---

<div class="flex flex-wrap items-center gap-2">
  <button type="button" data-copy-page={markdown} hidden class="btn h-8 px-3 text-[13px]">
    Copy page
  </button>
  <a href={markdown} class="btn h-8 px-3 text-[13px]">
    View as Markdown
  </a>
</div>
