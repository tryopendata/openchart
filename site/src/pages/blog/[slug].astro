---
/** One blog post, rendered in BlogLayout. Every post in `allPosts()` gets a page. */
import type { GetStaticPaths } from "astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { allPosts, type PostEntry } from "../../lib/collection";

export const getStaticPaths = (async () =>
  (await allPosts()).map((entry) => ({
    params: { slug: entry.post.slug },
    props: { entry },
  }))) satisfies GetStaticPaths;

interface Props {
  entry: PostEntry;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
---

<BlogLayout post={entry.post}>
  <Content />
</BlogLayout>
