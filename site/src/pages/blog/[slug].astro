---
/** One blog post, rendered in BlogLayout with its reading time and related docs links. Every post in `allPosts()` gets a page. */
import type { GetStaticPaths } from "astro";
import BlogLayout from "../../layouts/BlogLayout.astro";
import { readingTime, relatedLinks } from "../../lib/blog";
import { allPages, allPosts, type PostEntry } from "../../lib/collection";

export const getStaticPaths = (async () =>
  (await allPosts()).map((entry) => ({
    params: { slug: entry.post.slug },
    props: { entry },
  }))) satisfies GetStaticPaths;

interface Props {
  entry: PostEntry;
}
const { entry } = Astro.props;
const { Content } = await entry.render();
const pages = (await allPages()).map(({ page }) => page);
---

<BlogLayout
  post={entry.post}
  minutes={readingTime(entry.body)}
  related={relatedLinks(entry.post.related, pages)}
>
  <Content />
</BlogLayout>
