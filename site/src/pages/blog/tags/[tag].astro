---
/**
 * One tag's page: the posts that carry the tag, newest first, listed as the
 * index lists them. A page exists for each tag at least one post uses. Kept
 * out of the search index and the sitemap, and `noindex, follow` so its links
 * still count.
 */
import type { GetStaticPaths } from "astro";
import BlogBreadcrumb from "../../../components/blog/BlogBreadcrumb.astro";
import PostList from "../../../components/blog/PostList.astro";
import type { BlogTag } from "../../../config";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { postsByTag, readingTime, tagPath, tagsInUse } from "../../../lib/blog";
import type { BlogPost } from "../../../lib/blog-types";
import { allPosts } from "../../../lib/collection";
import "../../../styles/blog.css";

export const getStaticPaths = (async () => {
  const entries = await allPosts();
  const posts = entries.map(({ post }) => post);
  const minutes = new Map(entries.map(({ post, body }) => [post, readingTime(body)]));
  return tagsInUse(posts).map((tag) => ({
    params: { tag: tag.id },
    props: {
      tag,
      // Every post postsByTag returns came from `posts`, so the map has its minutes.
      items: postsByTag(posts, tag.id).map((post) => ({ post, minutes: minutes.get(post) ?? 1 })),
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  tag: BlogTag;
  items: { post: BlogPost; minutes: number }[];
}
const { tag, items } = Astro.props;
const count = items.length === 1 ? "One post" : `${items.length} posts`;
---

<BaseLayout
  title={`${tag.label} posts`}
  description={`Blog posts tagged ${tag.label}, newest first.`}
  path={tagPath(tag.id)}
  robots="noindex, follow"
>
  <div class="blog-index">
    <header class="blog-index-header">
      <BlogBreadcrumb />
      <h1 class="blog-headline">{tag.label}</h1>
      <p class="blog-standfirst">
        {count} tagged {tag.label}, newest first.
      </p>
    </header>
    <div class="rule-axis mt-8"></div>
    <PostList items={items} />
  </div>
</BaseLayout>
