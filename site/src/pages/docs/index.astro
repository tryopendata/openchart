---
import { docsGroups, site } from "../../config";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getDocs } from "../../lib/collection";
import { docHref, docsNav } from "../../lib/docs";

const nav = docsNav(await getDocs(), docsGroups);
---

<BaseLayout
  title="Documentation"
  description={`Install, learn and configure ${site.name}.`}
  path="/docs/"
>
  <div class="prose mx-auto max-w-4xl px-6 py-10">
    <h1>Documentation</h1>
    <p>
      Every page here is also served as Markdown, and <a href="/llms.txt">llms.txt</a> lists them
      all.
    </p>
    {nav.map((group) => (
      <section aria-labelledby={`group-${group.id}`}>
        <h2 id={`group-${group.id}`}>{group.label}</h2>
        <ul class="not-prose grid gap-4 sm:grid-cols-2">
          {group.items.map((item) => (
            <li class="border-line rounded-lg border p-4">
              <a href={docHref(item.id)} class="font-semibold">
                {item.title}
              </a>
              <p class="text-muted mt-1 text-sm">{item.description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</BaseLayout>
