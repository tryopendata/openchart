---
/**
 * The examples gallery: every entry in `galleryEntries` as a finished graphic
 * on one wall, in wall order, with a filter by kind. Wide entries are the
 * wall's features, alternating left and right. Each tile links to its entry
 * page. src/scripts/gallery.ts runs the filter and scales the live charts;
 * the page takes no island. Not indexed by search.
 */
import GalleryFilter from "../../components/gallery/GalleryFilter.astro";
import GalleryTile from "../../components/gallery/GalleryTile.astro";
import { isFeature } from "../../components/gallery/tile-size";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { galleryEntries } from "../../lib/gallery";
import "../../styles/gallery.css";

const tiles = galleryEntries.map((entry, index) => {
  const featuresBefore = galleryEntries.slice(0, index).filter(isFeature).length;
  return { entry, featureEnd: featuresBefore % 2 === 1 };
});
---

<BaseLayout
  title="Examples"
  description="Charts, maps and tables drawn with OpenChart from published data. Each opens with the spec that draws it and a link to its docs."
  path="/examples/"
>
  <div class="gallery-page">
    <header class="gallery-head">
      <h1 class="gallery-title">Examples</h1>
      <p class="gallery-lede">
        Every graphic here is drawn by OpenChart from published data. Open one for the live chart,
        the spec that draws it and the docs for its kind of chart.
      </p>
    </header>
    <div data-gallery>
      <GalleryFilter entries={galleryEntries} />
      <ul class="gallery-grid" role="list">
        {tiles.map(({ entry, featureEnd }) => (
          <GalleryTile entry={entry} feature featureEnd={featureEnd} />
        ))}
      </ul>
    </div>
  </div>
</BaseLayout>

<script>
  import "../../scripts/gallery";
</script>
