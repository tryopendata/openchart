---
/**
 * The docs page shell, built from DocsLayoutProps alone. At 1280px and wider: the
 * area switcher and sidebar, the article, and an "On this page" column. From 1024px
 * the outline column folds into the sidebar under the current page. Below 1024px
 * the sidebar becomes a "Docs menu" disclosure that opens without JavaScript.
 * The article is what Pagefind indexes, filed under the page's area; its
 * breadcrumb, page actions and pager are left out of the index.
 */
import AreaSwitcher from "../components/docs/AreaSwitcher.astro";
import Breadcrumb from "../components/docs/Breadcrumb.astro";
import PageActions from "../components/docs/PageActions.astro";
import PageOutline from "../components/docs/PageOutline.astro";
import Pager from "../components/docs/Pager.astro";
import Sidebar from "../components/docs/Sidebar.astro";
import type { DocsLayoutProps } from "../lib/docs-types";
import { searchBodyAttrs } from "../lib/search-index";
import BaseLayout from "./BaseLayout.astro";

type Props = DocsLayoutProps;
const { page, areas, nav, outline, prev, next } = Astro.props;
const area = areas.find((candidate) => candidate.id === page.area);
const sectionLabel = nav.find((section) => section.id === page.section)?.label ?? page.section;
---

<BaseLayout
  title={page.title}
  description={page.description}
  path={page.path}
  image={`/og/docs/${page.id}.png`}
  markdown={page.markdown}
>
  <div class="mx-auto grid max-w-[90rem] px-5 sm:px-6 lg:grid-cols-[15rem_minmax(0,1fr)] lg:px-8 xl:grid-cols-[15rem_minmax(0,1fr)_16rem]">
    <!-- Plain divs, not asides: each wraps a named nav, and two unnamed complementary
         landmarks would fail axe's landmark-unique rule. -->
    <div
      data-docs-rail
      class="border-line border-b lg:sticky lg:top-0 lg:max-h-screen lg:self-start lg:overflow-y-auto lg:border-b-0 lg:py-10 lg:pr-8"
    >
      <AreaSwitcher
        areas={areas}
        current={page.area}
        class="border-line pt-3 pb-2 lg:mb-7 lg:border-b lg:pt-0 lg:pb-5"
      />
      <details class="docs-menu border-line border-t lg:hidden">
        <summary>Docs menu</summary>
        <Sidebar
          label="Docs menu"
          nav={nav}
          currentId={page.id}
          outline={outline}
          class="pt-2 pb-8"
        />
      </details>
      <Sidebar
        label="Docs"
        nav={nav}
        currentId={page.id}
        outline={outline}
        outlineClass="xl:hidden"
        class="hidden lg:flex"
      />
    </div>

    <article
      class="border-line min-w-0 pt-8 pb-4 lg:border-l lg:pt-12 lg:pl-12"
      {...searchBodyAttrs(page.area)}
    >
      <header class="flex max-w-[44rem] flex-col gap-4">
        {area && <Breadcrumb area={area} section={sectionLabel} />}
        <h1 class="text-ink text-[2.125rem] leading-[1.1] font-medium tracking-[-0.02em] sm:text-[2.75rem]">
          {page.title}
        </h1>
        <p class="text-ink-2 text-lg leading-relaxed">{page.description}</p>
        <PageActions markdown={page.markdown} />
      </header>
      <div class="rule-axis mt-8 mb-10"></div>
      <div class="prose docs-prose max-w-none">
        <slot />
      </div>
      <Pager prev={prev} next={next} />
    </article>

    {outline.length > 0 && (
      <div class="hidden xl:block xl:pl-12">
        <nav aria-label="On this page" class="sticky top-0 max-h-screen overflow-y-auto py-12">
          <p class="text-ink mb-2 text-[13px] font-semibold">On this page</p>
          <PageOutline outline={outline} class="border-line border-l pl-3" />
        </nav>
      </div>
    )}
  </div>
</BaseLayout>
