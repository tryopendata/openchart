---
/**
 * A blog post's page, set as a long read: the breadcrumb back to the blog, the
 * headline, the description as its standfirst, the byline and the ticked rule,
 * then the post in the docs prose styles with the body in the display serif,
 * the end-of-post CTA and the related docs and tags. Text keeps a 45rem
 * reading measure; figures break out to a 64rem column on wide screens and run
 * edge to edge on phones (the column lines are in blog.css).
 *
 * Entrances come from `@steamfield/ui/reveal`. The header is above the fold, so
 * it is marked revealed in the HTML and paints in place before any module
 * script runs, like a PublishedFigure with `reveal={false}`; its roles (the
 * rule wipes, the text lifts) match that frame. The endnotes enter as they are
 * reached, the CTA carries its own reveal, and paragraphs and headings never
 * animate. The head carries the BlogPosting JSON-LD and the article times. The
 * article is indexed by search under Blog.
 */
import BlogCta from "../components/blog/BlogCta.astro";
import Byline from "../components/blog/Byline.astro";
import BlogBreadcrumb from "../components/blog/BlogBreadcrumb.astro";
import PostEndnotes from "../components/blog/PostEndnotes.astro";
import { site } from "../config";
import {
  articleJsonLd,
  isoDay,
  lastModified,
  postPath,
  type RelatedLink,
  tagsOf,
} from "../lib/blog";
import type { BlogPost } from "../lib/blog-types";
import { searchBodyAttrs } from "../lib/search-index";
import "../styles/blog.css";
import BaseLayout from "./BaseLayout.astro";

interface Props {
  post: BlogPost;
  /** Minutes to read, from `readingTime()`. */
  minutes: number;
  /** The post's related docs pages, from `relatedLinks()`. */
  related: readonly RelatedLink[];
}
const { post, minutes, related } = Astro.props;
const path = postPath(post.slug);
const image = `/og/blog/${post.slug}.png`;
const jsonLd = articleJsonLd(post, {
  canonical: new URL(path, site.url).href,
  image: new URL(image, site.url).href,
  publisher: { name: site.name, url: site.url },
});
---

<BaseLayout
  title={post.title}
  description={post.description}
  path={path}
  image={image}
  ogType="article"
>
  <Fragment slot="head">
    <meta property="article:published_time" content={isoDay(post.published)} />
    <meta property="article:modified_time" content={isoDay(lastModified(post))} />
    <script type="application/ld+json" set:html={jsonLd} />
  </Fragment>

  <article class="blog-article" {...searchBodyAttrs("blog")}>
    <div data-reveal data-revealed>
      <header class="blog-article-header" data-motion="lift-sm">
        <BlogBreadcrumb />
        <h1 class="blog-headline">{post.title}</h1>
        <p class="blog-standfirst">{post.description}</p>
        <Byline
          author={post.author}
          published={post.published}
          updated={post.updated}
          minutes={minutes}
        />
      </header>
      <div class="rule-axis mt-8 mb-10" data-motion="wipe"></div>
    </div>
    <div class="prose docs-prose blog-prose max-w-none">
      <slot />
    </div>
    <BlogCta />
    <div data-reveal data-motion="quiet">
      <PostEndnotes related={related} tags={tagsOf(post)} />
    </div>
  </article>
</BaseLayout>
