---
/**
 * The HTML shell every page shares: head metadata, the theme set before paint,
 * fonts, the site header and footer, and the client wiring for analytics, consent,
 * scroll entrances, site behavior, demos and the eager part of search. Every
 * page links the blog's RSS feed; a page adds its own head content (JSON-LD,
 * article meta) through the `head` slot.
 */
import SiteFooter from "./SiteFooter.astro";
import SiteHeader from "./SiteHeader.astro";
import { revealGateScript } from "@steamfield/ui/reveal";
import { demoGateScript } from "../lib/demo/page-gate";
import { site } from "../config";
import { preloadFonts } from "../lib/fonts";
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  /** Route path with its trailing slash, e.g. "/docs/" (never Astro.url, which a host can rewrite). */
  path: string;
  /** Social card path under /og/. */
  image?: string;
  /** This page's Markdown export, linked as rel="alternate". */
  markdown?: string;
  /** Shorthand for `robots="noindex, nofollow"`. */
  noindex?: boolean;
  /** The robots meta. `noindex, follow` keeps a thin page out of the index while its links still count. */
  robots?: "noindex, nofollow" | "noindex, follow";
  /** `article` for a blog post; every other page is a `website`. */
  ogType?: "website" | "article";
}
const {
  title,
  description = site.description,
  path,
  image = "/og-image.png",
  markdown,
  noindex = false,
  ogType = "website",
} = Astro.props;
const robots = Astro.props.robots ?? (noindex ? "noindex, nofollow" : undefined);
const canonical = new URL(path, site.url);
const ogImage = new URL(image, site.url);
const pageTitle = path === "/" ? `${site.name}: ${title}` : `${title} | ${site.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Fixes the cascade layer order before any stylesheet loads. A page's own CSS
         bundle can come ahead of the layout's, and whichever file names a layer
         first would otherwise decide the order (components below the base reset). */}
    <style is:inline>
      @layer theme, base, sf, components, utilities;
    </style>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {markdown && <link rel="alternate" type="text/markdown" href={markdown} />}
    <link rel="alternate" type="application/rss+xml" title="OpenChart blog" href="/blog/rss.xml" />
    {preloadFonts.map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e0f10" media="(prefers-color-scheme: dark)" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {robots && <meta name="robots" content={robots} />}
    {/* Page-specific head content: a blog post's JSON-LD and article meta. */}
    <slot name="head" />
    <script is:inline>
      // Before paint: the stored choice, else the system preference.
      // A class is always set while JavaScript runs, so the toggle's state matches
      // what is shown even when storage is blocked.
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch {
          // Storage blocked: fall back to the system preference below.
        }
        const dark = stored
          ? stored === "dark"
          : window.matchMedia("(prefers-color-scheme: dark)").matches;
        document.documentElement.classList.add(dark ? "dark" : "light");
      })();
    </script>
    {/* Scroll entrances: sets the CSS gate before paint and removes it if the module never arrives. */}
    <script is:inline set:html={revealGateScript} />
    {/* Demos: closes code blocks and holds back entering charts before paint; lifts if scripts never arrive. */}
    <script is:inline set:html={demoGateScript} />
    <script>
      import { initReveal } from "@steamfield/ui/reveal";
      import { initAnalytics } from "../lib/analytics";
      import { createSiteConsent, showConsentBanner } from "../lib/consent";
      import "../scripts/site";
      import "../scripts/demos";
      import "../scripts/search";

      // [data-reveal] containers animate in once, the first time they are seen.
      initReveal();

      // A build without a key ships no analytics and asks for no consent: this
      // branch is dropped while PUBLIC_POSTHOG_KEY is empty (dev, tests and CI).
      const key = import.meta.env.PUBLIC_POSTHOG_KEY;
      if (key) {
        const consent = createSiteConsent();
        initAnalytics({
          key,
          host: import.meta.env.PUBLIC_POSTHOG_HOST,
          site: "openchart",
          consent,
        });
        showConsentBanner(consent);
      }
    </script>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-canvas text-ink sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:p-2"
    >
      Skip to content
    </a>
    <slot name="banner" />
    <SiteHeader path={path} />
    <main id="main" class="flex-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
