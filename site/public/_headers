# Cloudflare Pages response headers. The build copies this file to dist/_headers;
# tests/deploy.test.mjs serves dist/ through `wrangler pages dev` and checks it.
# HTML, feeds, text exports, the sitemaps and /pagefind/* keep Pages' default
# revalidating cache: pagefind.js and pagefind-entry.json are not content-hashed,
# so they must revalidate.

/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/blog/rss.xml
  Content-Type: application/rss+xml; charset=utf-8

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
