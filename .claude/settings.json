{
  "permissions": {
    "allow": [
      "Skill",
      "WebFetch",
      "WebSearch",
      "Bash(git:*)",
      "Bash(bun:*)",
      "Bash(bunx:*)",
      "Bash(node:*)",
      "Bash(npx:*)",
      "Bash(make:*)",
      "Bash(vitest:*)",
      "Bash(eslint:*)",
      "Bash(prettier:*)",
      "Bash(tsc:*)",
      "Bash(tsup:*)",
      "Bash(ladle:*)",
      "Bash(cat:*)",
      "Bash(ls:*)",
      "Bash(pwd)",
      "Bash(echo:*)",
      "Bash(which:*)",
      "Bash(wc:*)"
    ],
    "deny": [
      "Bash(rm -rf /)",
      "Bash(rm -rf ~)",
      "Bash(rm -rf .)",
      "Bash(git push --force)",
      "Bash(git push -f)",
      "Bash(git reset --hard)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "FILE=$(jq -r '.tool_input.file_path'); if echo \"$FILE\" | grep -qE '\\.(ts|tsx|js|jsx|svelte)$'; then bunx biome format --write \"$FILE\" 2>&1; fi"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "ce@claude-essentials": true,
    "openchart@openchart": true
  },
  "extraKnownMarketplaces": {
    "claude-essentials": {
      "source": {
        "source": "git",
        "url": "https://github.com/rileyhilliard/claude-essentials.git"
      },
      "autoUpdate": true
    }
  },
  "_readme": "Claude Code configuration. Machine-specific overrides go in settings.local.json (gitignored)."
}
