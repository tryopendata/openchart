{
  "name": "@opendata-ai/monorepo",
  "version": "1.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/tryopendata/openchart.git"
  },
  "homepage": "https://github.com/tryopendata/openchart#readme",
  "bugs": "https://github.com/tryopendata/openchart/issues",
  "author": "Riley Hilliard",
  "engines": {
    "node": ">=18"
  },
  "workspaces": [
    "packages/*",
    "examples"
  ],
  "scripts": {
    "build": "bun run --filter '@opendata-ai/openchart-core' build && bun run --filter '@opendata-ai/openchart-engine' build && bun run --filter '@opendata-ai/openchart-vanilla' build && bun run --filter '@opendata-ai/openchart-react' --filter '@opendata-ai/openchart-vue' --filter '@opendata-ai/openchart-svelte' build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check packages/ examples/src/ examples/.ladle/",
    "lint:fix": "biome check --write packages/ examples/src/ examples/.ladle/",
    "format": "biome format --write packages/ examples/src/ examples/.ladle/",
    "typecheck": "bun run --filter './packages/*' typecheck && bun run --filter '@opendata-ai/examples' typecheck",
    "dev": "cd examples && bun run dev",
    "release": "node scripts/release.mjs",
    "generate:schema": "node scripts/generate-schema.mjs",
    "generate:llms": "node scripts/generate-llms.mjs",
    "generate:tokens": "bun scripts/generate-css-tokens.mjs",
    "generate": "bun run generate:schema && bun run generate:llms && bun run generate:tokens",
    "check:generated": "node scripts/generate-schema.mjs --check && node scripts/generate-llms.mjs --check && bun scripts/generate-css-tokens.mjs --check",
    "test:visual": "playwright test --project=visual --project=visual-mobile",
    "test:visual:update": "playwright test --project=visual --project=visual-mobile --update-snapshots",
    "test:visual:setup": "playwright install chromium webkit",
    "test:invariants": "playwright test --project=invariants --project=invariants-chromium-mobile --project=invariants-chromium-mobile-narrow --project=invariants-webkit-mobile",
    "test:perf": "playwright test --project=perf",
    "prepare": "husky"
  },
  "overrides": {
    "strip-ansi": "6.0.1",
    "string-width": "4.2.3",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^4.0.18",
    "ajv": "^8.20.0",
    "happy-dom": "^20.8.3",
    "husky": "^9.1.7",
    "lightningcss-cli": "^1.32.0",
    "lightningcss-cli-darwin-arm64": "^1.32.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ts-json-schema-generator": "^2.9.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.2",
    "vitest": "^4.0.18"
  }
}
