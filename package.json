{
  "name": "@openchart/monorepo",
  "version": "0.0.1",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/openchart/openchart.git"
  },
  "homepage": "https://github.com/openchart/openchart#readme",
  "bugs": "https://github.com/openchart/openchart/issues",
  "author": "Riley Hilliard",
  "engines": {
    "node": ">=18"
  },
  "workspaces": ["packages/*", "examples"],
  "scripts": {
    "build": "bun run --filter '@openchart/core' build && bun run --filter '@openchart/engine' build && bun run --filter '@openchart/vanilla' --filter '@openchart/react' build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check packages/ examples/src/",
    "lint:fix": "biome check --write packages/ examples/src/",
    "format": "biome format --write packages/ examples/src/",
    "typecheck": "bun run --filter './packages/*' typecheck",
    "dev": "cd examples && bun run dev"
  },
  "overrides": {
    "strip-ansi": "6.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.4",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.0.0",
    "@vitest/coverage-v8": "^3.0.0",
    "happy-dom": "^17.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
