{
  "layered": true,
  "options": { "width": 600, "height": 400 },
  "vl": {
    "data": [{ "cat": "A", "v": 1 }, { "cat": "A", "v": 2 }, { "cat": "B", "v": 3 }],
    "layer": [
      {
        "mark": "bar",
        "encoding": {
          "x": { "field": "cat", "type": "nominal" },
          "y": { "aggregate": "count" }
        }
      }
    ]
  },
  "canonical": {
    "data": [{ "cat": "A", "v": 1 }, { "cat": "A", "v": 2 }, { "cat": "B", "v": 3 }],
    "layer": [
      {
        "mark": "bar",
        "transform": [
          {
            "aggregate": [{ "op": "count", "field": "__count", "as": "__count" }],
            "groupby": ["cat"]
          }
        ],
        "encoding": {
          "x": { "field": "cat", "type": "nominal" },
          "y": { "field": "__count", "type": "quantitative", "title": "Count" }
        }
      }
    ]
  }
}
