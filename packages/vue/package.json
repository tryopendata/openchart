{
  "name": "@opendata-ai/openchart-vue",
  "version": "7.1.2",
  "description": "Vue 3 components for openchart: <Chart />, <DataTable />, <Graph />, <VizThemeProvider />",
  "license": "Apache-2.0",
  "author": "Riley Hilliard",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryopendata/openchart.git",
    "directory": "packages/vue"
  },
  "homepage": "https://github.com/tryopendata/openchart#readme",
  "bugs": "https://github.com/tryopendata/openchart/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "keywords": [
    "chart",
    "visualization",
    "vue",
    "data-table",
    "svg",
    "d3",
    "declarative"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opendata-ai/openchart-core": "workspace:*",
    "@opendata-ai/openchart-engine": "workspace:*",
    "@opendata-ai/openchart-vanilla": "workspace:*"
  },
  "peerDependencies": {
    "vue": ">=3.3.0"
  },
  "devDependencies": {
    "@vue/test-utils": "^2.4.0",
    "vue": "^3.5.0"
  }
}
