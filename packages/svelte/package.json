{
  "name": "@opendata-ai/svelte",
  "version": "1.1.0",
  "description": "Svelte components for openchart: <Chart />, <DataTable />, <Graph />, <VizThemeProvider />",
  "license": "Apache-2.0",
  "author": "Riley Hilliard",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryopendata/openchart.git",
    "directory": "packages/svelte"
  },
  "homepage": "https://github.com/tryopendata/openchart#readme",
  "bugs": "https://github.com/tryopendata/openchart/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "svelte": "./dist/index.js",
  "sideEffects": false,
  "keywords": [
    "chart",
    "visualization",
    "svelte",
    "data-table",
    "svg",
    "d3",
    "declarative"
  ],
  "scripts": {
    "build": "svelte-package -i src -o dist",
    "test": "vitest run",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@opendata-ai/core": "workspace:*",
    "@opendata-ai/engine": "workspace:*",
    "@opendata-ai/vanilla": "workspace:*"
  },
  "peerDependencies": {
    "svelte": ">=5.0.0"
  },
  "devDependencies": {
    "@sveltejs/package": "^2.3.0",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.2.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0"
  }
}
