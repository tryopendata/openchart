{
  "name": "@opendata-ai/openchart-vanilla",
  "version": "8.0.0-rc.19",
  "description": "Vanilla JS renderer for openchart: SVG charts, HTML tables, force-directed graphs",
  "license": "Apache-2.0",
  "author": "Riley Hilliard",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryopendata/openchart.git",
    "directory": "packages/vanilla"
  },
  "homepage": "https://github.com/tryopendata/openchart#readme",
  "bugs": "https://github.com/tryopendata/openchart/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./static": {
      "types": "./dist/static.d.ts",
      "import": "./dist/static.js"
    },
    "./story": {
      "types": "./dist/story/index.d.ts",
      "import": "./dist/story/index.js"
    },
    "./gif": {
      "types": "./dist/export-gif.d.ts",
      "import": "./dist/export-gif.js"
    },
    "./styles.css": "./dist/styles.css",
    "./simulation-worker": "./dist/simulation-worker.js"
  },
  "files": [
    "dist"
  ],
  "sideEffects": [
    "./dist/styles.css"
  ],
  "keywords": [
    "chart",
    "visualization",
    "svg",
    "data-table",
    "vanilla-js",
    "d3"
  ],
  "scripts": {
    "build": "tsup && bun build src/graph/simulation-worker.ts --outfile dist/simulation-worker.js --target=browser --format=iife",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@floating-ui/dom": "^1.7.6",
    "@opendata-ai/openchart-core": "workspace:*",
    "@opendata-ai/openchart-engine": "workspace:*",
    "d3-force": "^3.0.0",
    "d3-interpolate": "^3.0.0",
    "d3-quadtree": "^3.0.1"
  },
  "peerDependencies": {
    "gifenc": ">=1.0.0",
    "happy-dom": ">=14.0.0"
  },
  "peerDependenciesMeta": {
    "gifenc": {
      "optional": true
    },
    "happy-dom": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/d3-force": "^3.0.10",
    "@types/d3-interpolate": "^3.0.4",
    "@types/d3-quadtree": "^3.0.6",
    "gifenc": "^1.0.3"
  }
}
