{
  "name": "@opendata-ai/react",
  "version": "1.0.1",
  "description": "React components for openchart: <Chart />, <DataTable />, <VizThemeProvider />",
  "license": "Apache-2.0",
  "author": "Riley Hilliard",
  "repository": {
    "type": "git",
    "url": "https://github.com/tryopendata/openchart.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/tryopendata/openchart#readme",
  "bugs": "https://github.com/tryopendata/openchart/issues",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "keywords": [
    "chart",
    "visualization",
    "react",
    "data-table",
    "svg",
    "d3",
    "declarative"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@opendata-ai/core": "workspace:*",
    "@opendata-ai/engine": "workspace:*",
    "@opendata-ai/vanilla": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
